<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: the YouTube-X badge. The art is full-bleed, so `ic_launcher_logo_inset`
     places it inside the 66dp safe zone the platform masks. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_dynamic_foreground" />
</adaptive-icon>
